{
  "manifest_version": 3,
  "name": "Hub MCC D0",
  "version": "1.2.0",
  "description": "Captura a grade D0 da MCC ou encaminha um CSV manual ao Preparador local.",
  "icons": {
    "64": "icon.png"
  },
  "action": {
    "default_title": "Capturar D0 da MCC",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8765/preparador-MCC/*"]
}
