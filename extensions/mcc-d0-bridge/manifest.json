{
  "manifest_version": 3,
  "name": "Hub MCC D0",
  "version": "1.2.18",
  "description": "Captura MCC D0/D−1, produtos e países comuns ClickBank e controla a velocidade de VSL.",
  "icons": {
    "64": "icon.png"
  },
  "action": {
    "default_title": "Hub · MCC, ClickBank e velocidade VSL",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["scripting", "activeTab", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:8765/preparador-MCC/*", "http://127.0.0.1:8765/curadoria/clickbank-top-offers/*"]
}
